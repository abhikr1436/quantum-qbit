<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect www.quantumqbit.in to quantumqbit.in (Canonical Domain)
  RewriteCond %{HTTP_HOST} ^www\.quantumqbit\.in$ [NC]
  RewriteRule ^(.*)$ https://quantumqbit.in/$1 [R=301,L]

  # Redirect old ISRO PYQ URL to new SEO-friendly URL
  RewriteRule ^isro-pyq(.*)$ /isro-ta-computer-science-pyq$1 [R=301,L]

  # 1. Do not rewrite requests that are already for the dist/ folder
  RewriteCond %{REQUEST_URI} ^/dist/ [NC]
  RewriteRule ^ - [L]

  # 2. If the requested file or directory exists under the dist/ directory, serve it
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. For all other routes (SPA client-side routing), rewrite to dist/index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /dist/index.php [L]
</IfModule>

# Cache-Control and Expires headers for Static Assets (PageSpeed optimization)
<IfModule mod_expires.c>
  ExpiresActive On
  # Do not use ExpiresDefault to prevent caching HTML/PHP/JSON files by default
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Unset X-Powered-By header for security and clean SEO headers
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Cache static assets for 1 year
  <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|js|css|webp|svg|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  # Explicitly prevent caching of HTML, PHP, and JSON files to force dynamic updates
  <FilesMatch "\.(html|htm|php|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
